{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitradingsystem.local/schema/historical_gap_recovery.v1.schema.json",
  "title": "Historical gap recovery evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_id",
    "owner_decision_id",
    "recovery_id",
    "session_date",
    "component_id",
    "action_status",
    "recovery_mode",
    "generated_at",
    "result_classification",
    "strict_pit_eligible",
    "consumer_cutover_allowed",
    "canonical_history_status",
    "queue_binding",
    "policy_binding",
    "source_snapshot",
    "evidence",
    "consumer_outputs",
    "source_artifacts",
    "canonical_guard_evidence",
    "exclusions",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "historical_gap_recovery.v1"},
    "status": {"const": "HISTORICAL_GAP_RECOVERY_EVIDENCE"},
    "task_id": {"const": "OPS-079_HISTORICAL_DAILY_GAP_RECOVERY_EXECUTOR"},
    "owner_decision_id": {"type": "string", "pattern": "^owner_decision:[A-Za-z0-9._:-]+$"},
    "recovery_id": {"type": "string", "pattern": "^daily-input-recovery-[0-9a-f]{20}$"},
    "session_date": {"type": "string", "format": "date"},
    "component_id": {"enum": ["market_macro", "sec_companyfacts"]},
    "action_status": {"enum": ["READY_FOR_MANUAL_RECOVERY", "OWNER_REVIEW_REQUIRED"]},
    "recovery_mode": {"enum": ["IMMUTABLE_RAW_BACKFILL", "MANUAL_NON_PIT_RAW_REVIEW"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "result_classification": {"enum": ["IMMUTABLE_RAW_BACKFILL_EVIDENCE", "MANUAL_NON_PIT_RAW_REVIEW"]},
    "strict_pit_eligible": {"const": false},
    "consumer_cutover_allowed": {"const": false},
    "canonical_history_status": {"type": "object"},
    "queue_binding": {"type": "object"},
    "policy_binding": {"type": "object"},
    "source_snapshot": {"type": "object"},
    "evidence": {"type": "object"},
    "consumer_outputs": {"type": "object"},
    "source_artifacts": {"type": "array"},
    "canonical_guard_evidence": {"type": "object"},
    "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety": {"type": "object"}
  }
}
